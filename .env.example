# Required
DATABASE_URL=postgres://nichedb:nichedb@localhost:5432/nichedb
SITE_URL=http://localhost:3000

# Optional infrastructure
REDIS_URL=redis://localhost:6379
ROLES=web,worker
PORT=3000

# Who is an admin on first sign-in (comma separated). The first account ever
# created is an admin regardless.
ADMIN_EMAILS=

# Let any signed-in account add sources (default: admins and Pro members only).
OPEN_SOURCES=0

# Identify this deployment to upstreams that ask (SEC, PyPI, crates.io all do).
CONTACT_EMAIL=you@example.com

# Mail (magic links) via Resend
RESEND_API_KEY=
MAIL_FROM="NicheDB <hello@example.com>"

# Web push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Adapter credentials, only for the adapters that need one
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
GITHUB_TOKEN=
COURTLISTENER_TOKEN=
# Hosting catalogues that answer nothing without a credential; their sources stay paused until set
HETZNER_API_TOKEN=
DIGITALOCEAN_TOKEN=
UPCLOUD_USERNAME=
UPCLOUD_PASSWORD=
# An Obscura MCP server (private address) for storefronts that only render with JavaScript; optional
OBSCURA_MCP_URL=

# CoinPay: Pro membership checkout + webhook
COINPAY_API_KEY=
COINPAY_BUSINESS_ID=
COINPAY_WEBHOOK_SECRET=
# Pro is the no-ads tier: a month at a time.
MEMBERSHIP_PRICE_CENTS=12000
MEMBERSHIP_TERM_DAYS=30

# CrawlProof ads on free pages and feeds: the publisher slot to fill from
# (`crawlproof slots create <your host>`). Empty means no ads anywhere.
CRAWLPROOF_AD_SLOT=

# x402 crawl passes (@profullstack/x402-gateway): a SCOPED CoinPay key and the
# EVM address that receives USDC. Without both, training crawlers still get 402
# and nothing is sold.
COINPAY_X402_KEY=
CRAWL_PAY_TO=
CRAWL_PRICE_CENTS=100
CRAWL_PASS_MINUTES=1440
CRAWL_MAX_DAYS=30
# Loyalty: "spent cents:percent off" pairs. The more an agent has paid, the less a day costs.
CRAWL_LOYALTY=1000:20,5000:40,10000:60
CRAWL_FLOOR_CENTS=10

# The agent question loop. CHOVY_SIGNING_SECRET signs both directions
# (X-Chovy-Signature: t=<unix>,v1=<hmac-sha256 of "t.body">). Unset means the
# internal routes answer 503 rather than accepting unsigned work, because a
# question creates a scored contribution and moves somebody's revenue share.
CHOVY_SIGNING_SECRET=
# Optional: where an answered question is delivered back. Without it the loop
# still records and scores; the agent has to come and read instead.
CHOVY_WEBHOOK_URL=
