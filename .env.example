# Required
DATABASE_URL=postgres://nichedb:nichedb@localhost:5432/nichedb
SITE_URL=http://localhost:3000

# Optional infrastructure
REDIS_URL=redis://localhost:6379
ROLES=web,worker
PORT=3000

# Who is an admin on first sign-in (comma separated). The first account ever
# created is an admin regardless.
ADMIN_EMAILS=

# Let any signed-in account add sources (default: admins and Pro members only).
OPEN_SOURCES=0

# Identify this deployment to upstreams that ask (SEC, PyPI, crates.io all do).
CONTACT_EMAIL=you@example.com

# Mail (magic links) via Resend
RESEND_API_KEY=
MAIL_FROM="NicheDB <hello@example.com>"

# Web push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Adapter credentials, only for the adapters that need one
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
GITHUB_TOKEN=
COURTLISTENER_TOKEN=

# CoinPay: Pro membership checkout + webhook
COINPAY_API_KEY=
COINPAY_BUSINESS_ID=
COINPAY_WEBHOOK_SECRET=
MEMBERSHIP_PRICE_CENTS=1000

# x402 crawl passes (@profullstack/x402-gateway): a SCOPED CoinPay key and the
# EVM address that receives USDC. Without both, training crawlers still get 402
# and nothing is sold.
COINPAY_X402_KEY=
CRAWL_PAY_TO=
CRAWL_PRICE_CENTS=100
CRAWL_PASS_MINUTES=1440
