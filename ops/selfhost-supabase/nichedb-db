#!/usr/bin/env bash
#
# nichedb-db: move nichedb's Postgres off Railway onto self-hosted Supabase
# with logical replication, so the cutover costs minutes of failed writes
# instead of hours of downtime. Run from the dev box. See README.md for the
# runbook; `nichedb-db help` for the commands.
#
set -euo pipefail

HERE=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
STATE_DIR=${STATE_DIR:-$HOME/.local/state/nichedb-selfhost}
STATE=$STATE_DIR/state.env
mkdir -p "$STATE_DIR"
chmod 700 "$STATE_DIR"
# shellcheck disable=SC1090
[ -f "$STATE" ] && . "$STATE"

# ------------------------------------------------------------------ config
# Railway: project nichedb.dev, environment production.
RW_PROJECT=${RW_PROJECT:-fb518b20-ed8b-4066-a485-85c1b627063f}
RW_ENV=${RW_ENV:-dc6d3af4-c0b6-48bf-b93e-4ba0808209f1}
RW_PG_SERVICE=${RW_PG_SERVICE:-0e3bac56-c390-4afd-b9a2-6a98f5b66321}
RW_APP_SERVICE=${RW_APP_SERVICE:-fd8ab4c1-3787-461a-a9a6-3564603deee3}
RW_PG_SERVICE_NAME=${RW_PG_SERVICE_NAME:-Postgres}
SOURCE_DB=${SOURCE_DB:-railway}
# SOURCE_MODE=railway (production) or docker (rehearsal: SOURCE_CONTAINER).
SOURCE_MODE=${SOURCE_MODE:-railway}
SOURCE_CONTAINER=${SOURCE_CONTAINER:-}
# TARGET_SSH=user@host of the new server, or `local` for a rehearsal.
TARGET_SSH=${TARGET_SSH:-}
TARGET_DIR=${TARGET_DIR:-/opt/nichedb-supabase}
TARGET_DB=${TARGET_DB:-postgres}
# SHARED_CLUSTER=1: the target is a database inside a Supabase cluster that
# another app already owns on the box (`prepare-db` instead of `provision`).
SHARED_CLUSTER=${SHARED_CLUSTER:-0}
PUB=${PUB:-nichedb_migrate}
SUB=${SUB:-nichedb_migrate}
APP_HEALTH_URL=${APP_HEALTH_URL:-https://nichedb.dev/healthz}
# The app reaches the database by the server's existing hostname. No new DNS
# names: `dns` only runs when you pass DB_DOMAIN yourself.
DB_DOMAIN=${DB_DOMAIN:-${TARGET_SSH#*@}}
STUDIO_DOMAIN=${STUDIO_DOMAIN:-}
DNS_ZONE=${DNS_ZONE:-nichedb.dev}
VAULT_TEAM=${VAULT_TEAM:-profullstack}
SSH_KEY=${SSH_KEY:-$HOME/.ssh/id_ed25519}
# Cap on WAL the source keeps for a stalled subscriber. Past it the slot is
# invalidated (re-run `subscribe`) instead of the Railway volume filling up.
SLOT_KEEP_GB=${SLOT_KEEP_GB:-8}

log() { printf '\n===> %s\n' "$*" >&2; }
note() { printf '     %s\n' "$*" >&2; }
warn() { printf 'WARNING: %s\n' "$*" >&2; }
die() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }

save_state() { # save_state KEY VALUE
  touch "$STATE"
  chmod 600 "$STATE"
  grep -v "^$1=" "$STATE" > "$STATE.tmp" || true
  printf '%s=%q\n' "$1" "$2" >> "$STATE.tmp"
  mv "$STATE.tmp" "$STATE"
  eval "$1=\$2"
}

confirm() { # confirm "question"  (skipped by --yes)
  [ "${YES:-0}" = 1 ] && return 0
  [ -t 0 ] || die "$1 -- rerun with --yes to proceed non-interactively"
  printf '%s [y/N] ' "$1" >&2
  local a
  read -r a
  [ "$a" = y ] || [ "$a" = Y ] || die "aborted"
}

# --------------------------------------------------------------- railway API
rw_token() {
  # The CLI's access token lives about an hour; every API call then answers
  # "Not Authorized". Any CLI command refreshes it, so refresh when close.
  local exp
  exp=$(jq -r '.user.tokenExpiresAt // 0' "$HOME/.railway/config.json")
  if [ "$exp" -lt $(($(date +%s) + 300)) ]; then railway whoami >/dev/null 2>&1 || die "railway login expired: run 'railway login'"; fi
  jq -r '.user.accessToken' "$HOME/.railway/config.json"
}

gql() { # gql QUERY [VARIABLES_JSON]
  local body
  body=$(jq -nc --arg q "$1" --argjson v "${2:-{\}}" '{query:$q, variables:$v}')
  local out
  out=$(curl -fsS https://backboard.railway.com/graphql/v2 \
    -H "Authorization: Bearer $(rw_token)" -H 'Content-Type: application/json' \
    -H 'User-Agent: nichedb-db' --data "$body")
  if [ "$(jq '.errors // [] | length' <<<"$out")" != 0 ]; then
    printf '%s\n' "$out" >&2
    return 1
  fi
  printf '%s' "$out"
}

rw_vars() { # rw_vars SERVICE_ID [unrendered]
  gql 'query($p:String!,$e:String!,$s:String!,$u:Boolean){variables(projectId:$p,environmentId:$e,serviceId:$s,unrendered:$u)}' \
    "$(jq -nc --arg p "$RW_PROJECT" --arg e "$RW_ENV" --arg s "$1" --argjson u "${2:-false}" '{p:$p,e:$e,s:$s,u:$u}')" |
    jq '.data.variables'
}

rw_set_var() { # rw_set_var SERVICE_ID NAME VALUE  (triggers a deploy)
  gql 'mutation($i:VariableUpsertInput!){variableUpsert(input:$i)}' \
    "$(jq -nc --arg p "$RW_PROJECT" --arg e "$RW_ENV" --arg s "$1" --arg n "$2" --arg v "$3" \
      '{i:{projectId:$p,environmentId:$e,serviceId:$s,name:$n,value:$v}}')" >/dev/null
}

rw_latest_deployment() { # rw_latest_deployment SERVICE_ID -> "id status createdAt"
  gql 'query($p:String!,$e:String!,$s:String!){deployments(first:1,input:{projectId:$p,environmentId:$e,serviceId:$s}){edges{node{id status createdAt}}}}' \
    "$(jq -nc --arg p "$RW_PROJECT" --arg e "$RW_ENV" --arg s "$1" '{p:$p,e:$e,s:$s}')" |
    jq -r '.data.deployments.edges[0].node | "\(.id) \(.status) \(.createdAt)"'
}

rw_tcp_proxy() { # -> "domain port id" or empty
  gql 'query($s:String!,$e:String!){tcpProxies(serviceId:$s,environmentId:$e){id domain proxyPort applicationPort}}' \
    "$(jq -nc --arg s "$RW_PG_SERVICE" --arg e "$RW_ENV" '{s:$s,e:$e}')" |
    jq -r '.data.tcpProxies[] | select(.applicationPort==5432) | "\(.domain) \(.proxyPort) \(.id)"' | head -n1
}

# ------------------------------------------------------------ SQL transports
railway_ssh_user() {
  if [ -z "${RW_PG_SSH_USER:-}" ]; then
    local u
    u=$(railway ssh config --dry-run -i "$SSH_KEY" --project "$RW_PROJECT" --environment "$RW_ENV" \
      --service "$RW_PG_SERVICE_NAME" 2>/dev/null | awk '$1=="User" {print $2; exit}')
    [ -n "$u" ] || die "could not read the Railway ssh user for $RW_PG_SERVICE_NAME (railway login?)"
    save_state RW_PG_SSH_USER "$u"
  fi
  printf '%s' "$RW_PG_SSH_USER"
}

src_exec() { # run a command inside the source Postgres container, stdin passed through
  case "$SOURCE_MODE" in
    docker) docker exec -i "$SOURCE_CONTAINER" "$@" ;;
    railway)
      # `railway ssh` itself fails host-key verification; plain ssh works.
      ssh -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile="$HOME/.ssh/known_hosts_railway" \
        -o ServerAliveInterval=30 -o LogLevel=ERROR -i "$SSH_KEY" -l "$(railway_ssh_user)" ssh.railway.com "$@"
      ;;
    *) die "SOURCE_MODE must be railway or docker" ;;
  esac
}

# Source SQL always runs with read-only off: after `cutover` the database
# default is read-only, and rollback/cleanup still have to write.
src_sql() { # SQL on stdin
  { echo "set default_transaction_read_only = off;"; cat; } |
    src_exec psql -U postgres -d "$SOURCE_DB" -v ON_ERROR_STOP=1 -X -q -At
}
src_q() { src_sql <<<"$1"; }

tgt_exec() { # run a shell command string on the target host
  if [ "$TARGET_SSH" = local ]; then
    bash -c "$1"
  else
    [ -n "$TARGET_SSH" ] || die "no target: run 'nichedb-db provision user@host' first (or set TARGET_SSH)"
    ssh -o BatchMode=yes -o ServerAliveInterval=30 "$TARGET_SSH" "$1"
  fi
}
tgt_sudo() { case "$TARGET_SSH" in local | root@*) printf '' ;; *) printf 'sudo -n ' ;; esac; }

tgt_sql_in() { # tgt_sql_in DB ROLE  (SQL on stdin)
  tgt_exec "$(tgt_sudo)docker exec -i supabase-db psql -h localhost -U $2 -d $1 -v ON_ERROR_STOP=1 -X -q -At"
}
tgt_sql() { tgt_sql_in "$TARGET_DB" "$1"; } # tgt_sql ROLE - supabase_admin or postgres
tgt_q() { tgt_sql supabase_admin <<<"$1"; }

tgt_copy() { # tgt_copy LOCAL_FILE REMOTE_PATH
  if [ "$TARGET_SSH" = local ]; then cp "$1" "$2"; else scp -q "$1" "$TARGET_SSH:$2"; fi
}

# --------------------------------------------------------------- helpers
source_conninfo() { # libpq conninfo the subscriber uses to reach the source
  if [ "$SOURCE_MODE" = docker ]; then
    printf 'host=%s port=5432 dbname=%s user=postgres password=%s' \
      "${SOURCE_HOST:-$SOURCE_CONTAINER}" "$SOURCE_DB" "${SOURCE_PASSWORD:?set SOURCE_PASSWORD}"
    return
  fi
  local proxy pw
  proxy=$(rw_tcp_proxy)
  [ -n "$proxy" ] || die "the Railway Postgres has no TCP proxy yet: run 'nichedb-db source-prep'"
  pw=$(rw_vars "$RW_PG_SERVICE" | jq -r '.PGPASSWORD // .POSTGRES_PASSWORD')
  set -- $proxy
  printf 'host=%s port=%s dbname=%s user=postgres password=%s sslmode=require' "$1" "$2" "$SOURCE_DB" "$pw"
}

target_url() {
  [ -n "${SELFHOST_DATABASE_URL:-}" ] || die "no SELFHOST_DATABASE_URL in state: run 'nichedb-db provision' (or fetch-connection)"
  printf '%s' "$SELFHOST_DATABASE_URL"
}

slot_lag_bytes() {
  src_q "select coalesce(pg_wal_lsn_diff(pg_current_wal_lsn(), confirmed_flush_lsn), -1)::bigint from pg_replication_slots where slot_name = '$SUB'"
}

sync_states() { # "r 53" etc.
  tgt_q "select srsubstate, count(*) from pg_subscription_rel r join pg_subscription s on s.oid = r.srsubid where s.subname = '$SUB' group by 1 order by 1" | tr '|' ' '
}

all_ready() {
  local notready
  notready=$(tgt_q "select count(*) from pg_subscription_rel r join pg_subscription s on s.oid = r.srsubid where s.subname = '$SUB' and srsubstate <> 'r'")
  [ "$notready" = 0 ]
}

schema_fingerprint() { # normalised public schema of one side: src|tgt
  local dump
  if [ "$1" = src ]; then
    dump=$(src_exec pg_dump -U postgres -d "$SOURCE_DB" --schema-only --no-owner --no-privileges -n public)
  else
    dump=$(tgt_exec "$(tgt_sudo)docker exec supabase-db pg_dump -h localhost -U supabase_admin -d $TARGET_DB --schema-only --no-owner --no-privileges -n public")
  fi
  # Drop comments, session SETs, \restrict keys and version banners.
  grep -Ev '^(--|SET |SELECT pg_catalog.set_config|\\(un)?restrict|CREATE SCHEMA public;|COMMENT ON SCHEMA public)' <<<"$dump" |
    sed -e 's/[[:space:]]*$//' | grep -v '^$'
}

# ---------------------------------------------------------------- commands
cmd_provision() { # provision user@host
  local host=${1:-$TARGET_SSH}
  [ -n "$host" ] || die "usage: nichedb-db provision user@host"
  save_state TARGET_SSH "$host"
  log "Provisioning $host"
  tgt_exec 'mkdir -p /tmp/nichedb-selfhost'
  tgt_copy "$HERE/server/setup-server.sh" /tmp/nichedb-selfhost/setup-server.sh
  local envs="DB_DOMAIN=$DB_DOMAIN STUDIO_DOMAIN=$STUDIO_DOMAIN"
  local k
  for k in SUPABASE_REF INSTALL_ROOT PROJECT SITE_URL DB_PORT PGDATA_DIR MEM_MB CPUS WITH_PROXY; do
    [ -n "${!k:-}" ] && envs="$envs $k=${!k}"
  done
  tgt_exec "sudo -n env $envs bash /tmp/nichedb-selfhost/setup-server.sh"
  cmd_fetch_connection
}

cmd_prepare_db() { # prepare-db user@host /path/to/supabase-project [dbname]
  local host=${1:-$TARGET_SSH} dir=${2:-$TARGET_DIR} db=${3:-${TARGET_DB_SHARED:-nichedb}}
  [ -n "$host" ] && [ -n "$dir" ] || die "usage: nichedb-db prepare-db user@host /path/to/supabase-project [dbname]"
  save_state TARGET_SSH "$host"
  save_state TARGET_DIR "$dir"
  save_state TARGET_DB "$db"
  save_state SHARED_CLUSTER 1
  log "Preparing database $db in the Supabase cluster at $host:$dir"
  tgt_exec "test -f $dir/.env && $(tgt_sudo)docker exec supabase-db pg_isready -h localhost -U postgres" >/dev/null ||
    die "no running Supabase cluster with $dir/.env on $host"
  local wal
  wal=$(tgt_sql_in postgres supabase_admin <<<"show wal_level")
  [ "$wal" = logical ] || die "cluster wal_level is $wal, not logical"
  if [ "$(tgt_sql_in postgres supabase_admin <<<"select count(*) from pg_database where datname = '$db'")" = 0 ]; then
    tgt_sql_in postgres supabase_admin <<<"create database $db owner postgres"
    note "database $db created"
  else
    note "database $db already exists"
  fi
  tgt_sql_in "$db" supabase_admin <<'EOF'
create extension if not exists citext with schema public;
create extension if not exists pg_trgm with schema public;
-- This database is the app's alone: PostgREST/anon never get into it. (Only
-- this database; the cluster's own `postgres` database is not touched.)
alter default privileges for role postgres in schema public revoke all on tables from anon, authenticated;
alter default privileges for role postgres in schema public revoke all on sequences from anon, authenticated;
alter default privileges for role postgres in schema public revoke all on functions from anon, authenticated;
revoke all on all tables in schema public from anon, authenticated;
revoke all on all sequences in schema public from anon, authenticated;
revoke all on all functions in schema public from anon, authenticated;
revoke usage on schema public from public, anon, authenticated;
grant usage on schema public to postgres, service_role;
EOF
  note "extensions citext + pg_trgm; anon/authenticated locked out of $db"
  local pw
  pw=$(tgt_exec "$(tgt_sudo)grep '^POSTGRES_PASSWORD=' $dir/.env | cut -d= -f2-")
  [ -n "$pw" ] || die "no POSTGRES_PASSWORD in $dir/.env"
  local port
  port=$(tgt_exec "$(tgt_sudo)grep '^POSTGRES_PORT=' $dir/.env | cut -d= -f2-")
  # Written by root into the shared project dir, 0600, same shape provision makes.
  tgt_exec "umask 077; $(tgt_sudo)tee $dir/nichedb-connection.env >/dev/null" <<EOF
# nichedb app connection (shared cluster, written by nichedb-db prepare-db). Keep secret.
SELFHOST_DATABASE_URL=postgres://postgres:${pw}@${DB_DOMAIN}:${port:-5432}/${db}?sslmode=require
SELFHOST_DB_DOMAIN=${DB_DOMAIN}
SELFHOST_DB_PORT=${port:-5432}
SELFHOST_DB_NAME=${db}
SELFHOST_POSTGRES_PASSWORD=${pw}
SELFHOST_SHARED_CLUSTER_DIR=${dir}
EOF
  cmd_fetch_connection
}

cmd_fetch_connection() {
  log "Fetching the connection details from the server"
  local f=$STATE_DIR/connection.env
  umask 077
  tgt_exec "$(tgt_sudo)cat $TARGET_DIR/nichedb-connection.env" > "$f"
  local line
  while IFS= read -r line; do
    case "$line" in SELFHOST_*=*) save_state "${line%%=*}" "${line#*=}" ;; esac
  done < "$f"
  local ip
  ip=$(tgt_exec "curl -fsS4 https://api.ipify.org" 2>/dev/null || true)
  [ -n "$ip" ] && save_state TARGET_IP "$ip"
  note "target ${TARGET_SSH} (${TARGET_IP:-ip unknown}); secrets saved in $STATE (0600)"
}

cmd_vault() {
  log "Saving the Supabase secrets to the team vault"
  local work
  work=$(mktemp -d)
  trap 'rm -rf "$work"' RETURN
  # 1) the server's whole Supabase .env as its own vault (not when the cluster
  #    belongs to another app: its owner keeps that vault)
  if [ "$SHARED_CLUSTER" != 1 ]; then
    tgt_exec "$(tgt_sudo)cat $TARGET_DIR/.env" > "$work/supabase.env"
    logicsrc teams push "$VAULT_TEAM" nichedb-supabase prod --env "$work/supabase.env"
  fi
  # 2) SELFHOST_* next to the app's own secrets, merged, never replacing them
  if logicsrc teams pull "$VAULT_TEAM" nichedb prod --env "$work/app.env" >/dev/null 2>&1 && [ -s "$work/app.env" ]; then
    local n=1
    while [ -e "$STATE_DIR/nichedb--prod.bak-$(printf %03d $n).env" ]; do n=$((n + 1)); done
    cp "$work/app.env" "$STATE_DIR/nichedb--prod.bak-$(printf %03d $n).env"
    chmod 600 "$STATE_DIR"/nichedb--prod.bak-*.env
    grep -v '^SELFHOST_' "$work/app.env" > "$work/merged.env" || true
    grep '^SELFHOST_' "$STATE_DIR/connection.env" >> "$work/merged.env"
    logicsrc teams push "$VAULT_TEAM" nichedb prod --env "$work/merged.env"
    note "nichedb--prod backup: $STATE_DIR/nichedb--prod.bak-$(printf %03d $n).env"
  else
    die "could not pull vault nichedb--prod; nothing pushed to it (the nichedb-supabase vault was saved)"
  fi
}

cmd_dns() {
  local ip=${1:-${TARGET_IP:-}}
  [ -n "$ip" ] || die "usage: nichedb-db dns <server-ipv4>"
  [ "$DB_DOMAIN" != "${TARGET_SSH#*@}" ] || die "DB_DOMAIN is the server's own name; nothing to add"
  [[ "$DB_DOMAIN" == *.$DNS_ZONE ]] || die "DB_DOMAIN $DB_DOMAIN is not under $DNS_ZONE"
  log "DNS: $DB_DOMAIN -> $ip"
  porkbun set "$DNS_ZONE" "${DB_DOMAIN%%.$DNS_ZONE}" A "$ip" --ttl 600
  [ -n "${TARGET_IPV6:-}" ] && porkbun set "$DNS_ZONE" "${DB_DOMAIN%%.$DNS_ZONE}" AAAA "$TARGET_IPV6" --ttl 600
  # A shared cluster's Studio belongs to the app that owns it.
  if [ "$SHARED_CLUSTER" != 1 ] && [ -n "$STUDIO_DOMAIN" ]; then
    porkbun set "$DNS_ZONE" "${STUDIO_DOMAIN%%.$DNS_ZONE}" A "$ip" --ttl 600
    [ -n "${TARGET_IPV6:-}" ] && porkbun set "$DNS_ZONE" "${STUDIO_DOMAIN%%.$DNS_ZONE}" AAAA "$TARGET_IPV6" --ttl 600
  fi
  return 0
}

cmd_check() {
  log "Source"
  src_q "select 'version '||current_setting('server_version')||', wal_level '||current_setting('wal_level')||', size '||pg_size_pretty(pg_database_size(current_database()))||', max_slot_wal_keep_size '||current_setting('max_slot_wal_keep_size')" | sed 's/^/     /'
  src_exec df -h /var/lib/postgresql/data 2>/dev/null | tail -1 | awk '{print "     disk: "$3" used, "$4" free of "$2}' || true
  log "Target"
  tgt_q "select 'version '||current_setting('server_version')||', ssl '||current_setting('ssl')||', shared_buffers '||current_setting('shared_buffers')||', size '||pg_size_pretty(pg_database_size(current_database()))" | sed 's/^/     /'
  tgt_exec "df -h $TARGET_DIR | tail -1" | awk '{print "     disk: "$3" used, "$4" free of "$2}'
  local srcsize tgtfree
  srcsize=$(src_q "select pg_database_size(current_database())")
  tgtfree=$(tgt_exec "df -B1 --output=avail $TARGET_DIR | tail -1")
  if [ "$tgtfree" -lt $((srcsize * 2)) ]; then
    warn "target has less than 2x the source size free; the copy plus index builds may not fit"
  fi
}

cmd_source_prep() {
  [ "$SOURCE_MODE" = railway ] || { note "SOURCE_MODE=$SOURCE_MODE: only the publication is created"; cmd_publication; return; }
  log "Preparing the Railway source"
  local wal
  wal=$(src_q "show wal_level")
  if [ "$wal" != logical ]; then
    confirm "Set wal_level=logical and RESTART Railway's Postgres (the app loses its DB for ~30-60 s)?"
    src_q "alter system set wal_level = logical; alter system set max_slot_wal_keep_size = '${SLOT_KEEP_GB}GB';"
    local dep
    dep=$(rw_latest_deployment "$RW_PG_SERVICE" | awk '{print $1}')
    gql 'mutation($id:String!){deploymentRestart(id:$id)}' "$(jq -nc --arg id "$dep" '{id:$id}')" >/dev/null
    note "restart requested for deployment $dep; waiting for Postgres"

    for _ in $(seq 1 60); do
      sleep 5
      wal=$(src_q "show wal_level" 2>/dev/null || true)
      [ "$wal" = logical ] && break
    done
    [ "$wal" = logical ] || die "wal_level is still '$wal' after the restart"
    note "wal_level=logical"
  else
    note "wal_level already logical"
    src_q "alter system set max_slot_wal_keep_size = '${SLOT_KEEP_GB}GB'; select pg_reload_conf();" >/dev/null
  fi

  local proxy
  proxy=$(rw_tcp_proxy)
  if [ -z "$proxy" ]; then
    confirm "Expose Railway's Postgres on a public TCP proxy (password + TLS) for the replication?"
    if ! gql 'mutation($i:TCPProxyCreateInput!){tcpProxyCreate(input:$i){id domain proxyPort}}' \
      "$(jq -nc --arg s "$RW_PG_SERVICE" --arg e "$RW_ENV" '{i:{serviceId:$s,environmentId:$e,applicationPort:5432}}')" >/dev/null; then
      die "tcpProxyCreate failed. Add it by hand: Railway > nichedb.dev > Postgres > Settings > Networking > TCP Proxy, port 5432; then rerun."
    fi
    for _ in $(seq 1 30); do proxy=$(rw_tcp_proxy); [ -n "$proxy" ] && break; sleep 5; done
  fi
  note "TCP proxy: $(awk '{print $1":"$2}' <<<"$proxy")"
  cmd_publication
}

cmd_publication() {
  local missing
  missing=$(src_q "select string_agg(c.relname, ', ') from pg_class c join pg_namespace n on n.oid = c.relnamespace where n.nspname = 'public' and c.relkind in ('r','p') and c.relreplident = 'd' and not exists (select 1 from pg_index i where i.indrelid = c.oid and i.indisprimary)")
  # With FOR ALL TABLES, an UPDATE on a table with no replica identity FAILS on
  # the source. Every table has a primary key today; refuse if that changes.
  [ -z "$missing" ] || die "tables without a primary key would break writes on the source: $missing"
  if [ "$(src_q "select count(*) from pg_publication where pubname = '$PUB'")" = 0 ]; then
    src_q "create publication $PUB for all tables"
    note "publication $PUB created (all tables)"
  else
    note "publication $PUB already exists"
  fi
}

cmd_schema() {
  log "Copying the schema (tables + primary keys; indexes come after the data)"
  local n
  n=$(tgt_q "select count(*) from pg_tables where schemaname = 'public'")
  if [ "$n" != 0 ] && [ "${FORCE:-0}" != 1 ]; then
    die "target already has $n tables in public; FORCE=1 to apply on top anyway"
  fi
  local d=$STATE_DIR/schema
  mkdir -p "$d"
  src_exec pg_dump -U postgres -d "$SOURCE_DB" --schema-only --no-owner --no-privileges --section=pre-data > "$d/pre.sql"
  src_exec pg_dump -U postgres -d "$SOURCE_DB" --schema-only --no-owner --no-privileges --section=post-data > "$d/post.sql"
  python3 "$HERE/lib/split_post_data.py" "$d/post.sql" "$d/pk.sql" "$d/rest.sql" >&2
  note "pre-data $(grep -c 'CREATE TABLE' "$d/pre.sql") tables; saved in $d"
  # Extensions need supabase_admin; everything else is owned by postgres, the
  # role the app connects as and runs its migrations with.
  grep -E '^CREATE EXTENSION' "$d/pre.sql" | tgt_sql supabase_admin
  tgt_sql postgres < "$d/pre.sql"
  tgt_sql postgres < "$d/pk.sql"
  tgt_sql supabase_admin <<'EOF'
revoke all on all tables in schema public from anon, authenticated;
revoke all on all sequences in schema public from anon, authenticated;
revoke all on all functions in schema public from anon, authenticated;
revoke usage on schema public from public, anon, authenticated;
grant usage on schema public to postgres, service_role;
EOF
  note "target now has $(tgt_q "select count(*) from pg_tables where schemaname = 'public'") tables in public"
}

cmd_subscribe() {
  log "Subscribing the target to the source"
  if [ "$(tgt_q "select count(*) from pg_subscription where subname = '$SUB'")" != 0 ]; then
    note "subscription $SUB already exists"
    return
  fi
  local conn
  conn=$(source_conninfo)
  # disable_on_error: a schema mismatch (a migration deployed mid-copy) parks
  # the subscription instead of retrying forever; `status` shows it.
  tgt_sql supabase_admin <<EOF
create subscription $SUB
  connection '$(sed "s/'/''/g" <<<"$conn")'
  publication $PUB
  with (copy_data = true, streaming = on, disable_on_error = true);
EOF
  note "initial copy started; follow it with: nichedb-db status"
}

cmd_status() {
  log "Replication"
  local st
  st=$(sync_states)
  note "tables by state (i=init d=copying f/s=syncing r=ready): ${st:-none}"
  tgt_q "select 'enabled='||subenabled from pg_subscription where subname='$SUB'" | sed 's/^/     /'
  tgt_q "select 'copying '||relid::regclass||': '||pg_size_pretty(bytes_processed) from pg_stat_progress_copy" | sed 's/^/     /'
  tgt_q "select 'worker '||coalesce(relid::regclass::text,'apply')||' received '||coalesce(received_lsn::text,'-')||' last msg '||coalesce(to_char(last_msg_receipt_time,'HH24:MI:SS'),'-') from pg_stat_subscription where subname='$SUB'" | sed 's/^/     /'
  local errs
  errs=$(tgt_q "select apply_error_count||' apply / '||sync_error_count||' sync errors' from pg_stat_subscription_stats where subname='$SUB'")
  note "${errs:-no stats}"
  local lag
  lag=$(slot_lag_bytes)
  note "source slot lag: $( [ -n "$lag" ] && numfmt --to=iec "$lag" 2>/dev/null || echo none)"
  src_q "select 'source slot '||slot_name||' wal_status='||wal_status||' safe_wal_size='||coalesce(pg_size_pretty(safe_wal_size),'unlimited') from pg_replication_slots where slot_name='$SUB'" | sed 's/^/     /'
  note "sizes: source $(src_q "select pg_size_pretty(pg_database_size(current_database()))"), target $(tgt_q "select pg_size_pretty(pg_database_size(current_database()))")"
  if [ -n "$(tgt_exec "test -f /tmp/nichedb-indexes.log && echo y" 2>/dev/null || true)" ]; then
    note "index build: $(tgt_exec "tail -n 2 /tmp/nichedb-indexes.log" | tr '\n' ' ')"
  fi
}

cmd_indexes() {
  local d=$STATE_DIR/schema
  [ -s "$d/pk.sql" ] || die "no $d/pk.sql: run 'nichedb-db schema' first"
  if ! all_ready && [ "${FORCE:-0}" != 1 ]; then
    die "the initial copy is not finished ($(sync_states | tr '\n' ' ')); FORCE=1 to build now"
  fi
  # Re-read post-data NOW: deploys since `schema` may have added indexes on the
  # source (the app builds some after boot), and those must exist here too.
  src_exec pg_dump -U postgres -d "$SOURCE_DB" --schema-only --no-owner --no-privileges --section=post-data > "$d/post.sql"
  python3 "$HERE/lib/split_post_data.py" "$d/post.sql" "$d/pk.now.sql" "$d/rest.sql" >&2
  # pg_dump stamps each dump with a fresh \restrict token: compare without it.
  if ! diff -q <(grep -v '^\\' "$d/pk.sql") <(grep -v '^\\' "$d/pk.now.sql") >/dev/null; then
    warn "primary keys changed on the source since 'schema'; a new table needs the subscription refreshed"
  fi
  log "Building indexes, unique and foreign keys on the target (detached; replication keeps streaming)"
  local mwm work
  mwm=$(tgt_q "show maintenance_work_mem")
  work=$(mktemp -d)
  {
    printf "set maintenance_work_mem = '%s';\n" "$mwm"
    cat "$d/rest.sql"
    printf "select 'INDEXES DONE';\n"
  } > "$work/indexes.sql"
  cat > "$work/indexes.sh" <<EOF
#!/bin/sh
docker exec -i supabase-db psql -h localhost -U postgres -d $TARGET_DB -v ON_ERROR_STOP=1 -X -q -At -e < /tmp/nichedb-indexes.sql
EOF
  tgt_copy "$work/indexes.sql" /tmp/nichedb-indexes.sql
  tgt_copy "$work/indexes.sh" /tmp/nichedb-indexes.sh
  rm -rf "$work"
  if [ "$TARGET_SSH" = local ]; then
    sh /tmp/nichedb-indexes.sh > /tmp/nichedb-indexes.log 2>&1 || { tail -n 5 /tmp/nichedb-indexes.log >&2; die "index build failed"; }
    tail -n 1 /tmp/nichedb-indexes.log >&2
  else
    # Detached: 26 GB of indexes outlives an ssh session.
    tgt_exec "$(tgt_sudo)nohup sh /tmp/nichedb-indexes.sh > /tmp/nichedb-indexes.log 2>&1 < /dev/null & sleep 1"
    note "running on the server; progress in /tmp/nichedb-indexes.log (nichedb-db status shows the tail)"
  fi
}

cmd_verify() {
  log "Schema diff (public), source vs target"
  local a b
  a=$(mktemp)
  b=$(mktemp)
  schema_fingerprint src > "$a"
  schema_fingerprint tgt > "$b"
  if diff -u "$a" "$b" > "$STATE_DIR/schema.diff"; then
    note "identical"
  else
    warn "schemas differ (full diff: $STATE_DIR/schema.diff):"
    head -n 40 "$STATE_DIR/schema.diff" >&2
    SCHEMA_DIFFERS=1
  fi
  rm -f "$a" "$b"

  log "Row counts (source, target)"
  # One query per side. The big tables compare max(id) unless FULL=1: an exact
  # count of 35M rows is a minute of I/O on each side.
  local big=${BIG_TABLES:-items} q
  q=$(src_q "select string_agg(format('select %L, %s from public.%I', tablename, case when tablename = any(string_to_array('$big', ' ')) and ${FULL:-0} = 0 then 'coalesce(max(id),0)::text' else 'count(*)::text' end, tablename), ' union all ' order by tablename) from pg_tables where schemaname = 'public'")
  local s g
  s=$(src_q "$q")
  g=$(tgt_q "$q")
  local bad
  bad=$(join -t'|' -a1 -a2 -e MISSING -o 0,1.2,2.2 <(sort <<<"$s") <(sort <<<"$g") |
    awk -F'|' '{st = ($2 == $3) ? "ok" : "DIFF"; if (st != "ok") n++; printf "     %-30s %12s %12s %s\n", $1, $2, $3, st} END {print n + 0 > "/dev/fd/3"}' 3>&1 1>&2)
  note "$bad table(s) differ (expected while writes are still flowing; items compares max(id))"
  [ "${SCHEMA_DIFFERS:-0}" = 0 ]
}

sync_sequences() {
  log "Copying sequence positions"
  local sql
  sql=$(src_q "select format('select setval(%L, %s, %L);', quote_ident(schemaname)||'.'||quote_ident(sequencename), coalesce(last_value, start_value), last_value is not null) from pg_sequences where schemaname = 'public'")
  tgt_sql supabase_admin <<<"$sql" >/dev/null
  note "$(wc -l <<<"$sql") sequences set"
}

cmd_cutover() {
  log "Preflight"
  all_ready || die "not every table is in state r: $(sync_states | tr '\n' ' ')"
  [ "$(tgt_q "select subenabled from pg_subscription where subname = '$SUB'")" = t ] || die "subscription is disabled: see 'nichedb-db status'"
  local si ti
  si=$(src_q "select count(*) from pg_indexes where schemaname = 'public'")
  ti=$(tgt_q "select count(*) from pg_indexes where schemaname = 'public'")
  [ "$si" = "$ti" ] || die "indexes: source $si, target $ti. Run/finish 'nichedb-db indexes' first"
  cmd_verify >/dev/null 2>&1 || die "schemas differ: run 'nichedb-db verify' and reconcile first"
  local lag
  lag=$(slot_lag_bytes)
  [ "$lag" -lt $((64 * 1024 * 1024)) ] || die "slot lag is $(numfmt --to=iec "$lag"); wait for it to drain"
  [ "$SOURCE_MODE" = docker ] || target_url >/dev/null
  if [ "$SOURCE_MODE" = railway ]; then
    tgt_exec "test -s $CERT_DIR/fullchain.pem && test -e /etc/nginx/sites-enabled/$APP_DOMAIN && docker image inspect nichedb:latest >/dev/null" ||
      die "app not staged on the box: run app-deploy, app-cert, app-vhost first"
  fi
  confirm "Cut over now? Writes fail for a few minutes; reads keep working from the old DB."

  log "1/6 Source read-only, sessions closed"
  src_q "alter database $SOURCE_DB set default_transaction_read_only = on"
  src_q "select count(pg_terminate_backend(pid)) from pg_stat_activity where datname = '$SOURCE_DB' and backend_type = 'client backend' and pid <> pg_backend_pid()" >/dev/null
  save_state CUTOVER_STARTED "$(date -u +%FT%TZ)"

  log "2/6 Waiting for the target to confirm every source write"
  local lsn done_=0
  lsn=$(src_q "select pg_current_wal_lsn()")
  for _ in $(seq 1 120); do
    if [ "$(src_q "select confirmed_flush_lsn >= '$lsn' from pg_replication_slots where slot_name = '$SUB'")" = t ]; then done_=1; break; fi
    sleep 2
  done
  [ "$done_" = 1 ] || die "target did not catch up to $lsn in 4 minutes. Source is still READ-ONLY: fix, or 'nichedb-db rollback'"
  note "caught up to $lsn"

  sync_sequences
  log "3/6 Final counts"
  cmd_verify || warn "verify reported differences; check before trusting the target"

  log "4/6 Dropping the subscription (also drops the slot on the source)"
  tgt_q "drop subscription $SUB"

  if [ "$SOURCE_MODE" = railway ]; then
    log "5/6 Railway app stays on its read-only copy for the DNS TTL, web only"
    # Not repointed at the new database: dev2's 5432 is allowlisted and
    # Railway's egress addresses are not fixed. Stale resolvers get reads
    # from Railway for up to ten minutes; writes there fail until they move.
    if [ "$(rw_vars "$RW_APP_SERVICE" | jq -r '.ROLES')" != web ]; then
      rw_set_var "$RW_APP_SERVICE" ROLES web
      wait_for_deploy "$RW_APP_SERVICE"
    fi

    log "6/6 The app on this box, then DNS"
    cmd_app_deploy --start
    local via
    via=$(curl -sk --max-time 20 --resolve "$APP_DOMAIN:443:$TARGET_IP" "https://$APP_DOMAIN/healthz" || true)
    [ "$via" = ok ] || die "https://$APP_DOMAIN via $TARGET_IP answered '$via', not ok; DNS NOT moved (Railway still serves it from the new DB)"
    cmd_app_dns "$TARGET_IP"
    note "DNS moved; Railway keeps answering old resolvers for the TTL, from the same database"
    note "app connections on the target: $(tgt_q "select count(*) from pg_stat_activity where usename = 'postgres' and client_addr is not null and client_addr <> '127.0.0.1'")"
  else
    note "5/6 and 6/6 skipped (rehearsal: no app to repoint)"
  fi
  save_state CUTOVER_DONE "$(date -u +%FT%TZ)"
  log "Cut over. The Railway DB stays READ-ONLY as the fallback; 'nichedb-db rollback' undoes the switch."
}

wait_for_deploy() {
  local before status id _
  before=$(date -u +%FT%TZ)
  for _ in $(seq 1 90); do
    sleep 10
    read -r id status _ <<<"$(rw_latest_deployment "$1")"
    note "deployment $id: $status"
    case "$status" in
      SUCCESS) return 0 ;;
      FAILED | CRASHED) die "deployment $id $status: consider 'nichedb-db rollback'" ;;
    esac
  done
  die "deployment still not SUCCESS after 15 minutes (started $before)"
}

cmd_rollback() {
  warn "Rollback points the app back at Railway. Writes made on the new server since the cutover are NOT copied back."
  confirm "Roll back to the Railway database?"
  if [ "$SOURCE_MODE" = railway ]; then
    rw_set_var "$RW_APP_SERVICE" ROLES web,worker
    note "ROLES=web,worker on Railway again"
    tgt_exec "cd $APP_DIR 2>/dev/null && docker compose -f docker-compose.app.yml --env-file deploy.env stop app" 2>/dev/null || true
    note "app on the box stopped"
    if [ -n "${APP_DNS_FLIPPED:-}" ]; then
      warn "DNS was moved to this box at $APP_DNS_FLIPPED; restore nichedb.dev at Porkbun by hand from $STATE_DIR/$APP_DOMAIN-dns.bak-*.json (ALIAS apex -> Railway, www CNAME)"
    fi
  fi
  src_q "alter database $SOURCE_DB reset default_transaction_read_only"
  src_q "select count(pg_terminate_backend(pid)) from pg_stat_activity where datname = '$SOURCE_DB' and backend_type = 'client backend' and pid <> pg_backend_pid()" >/dev/null
  note "source is writable again"
  [ "$SOURCE_MODE" = railway ] && wait_for_deploy "$RW_APP_SERVICE"
  return 0
}

cmd_cleanup() {
  confirm "Drop the publication and any leftover slot on the source, and remove the TCP proxy?"
  src_q "drop publication if exists $PUB"
  src_q "select pg_drop_replication_slot(slot_name) from pg_replication_slots where slot_name = '$SUB' and not active" >/dev/null
  if [ "$SOURCE_MODE" = railway ]; then
    local proxy
    proxy=$(rw_tcp_proxy)
    if [ -n "$proxy" ]; then
      gql 'mutation($id:String!){tcpProxyDelete(id:$id)}' "$(jq -nc --arg id "$(awk '{print $3}' <<<"$proxy")" '{id:$id}')" >/dev/null
      note "TCP proxy removed"
    fi
  fi
  note "The Railway Postgres service itself is left in place (read-only). Delete it by hand once you no longer want the fallback."
}

# ------------------------------------------------- the app, on the same box
# nichedb.dev itself moves with its database: the app runs from Docker under
# ~/www/nichedb.dev like every other site on a fleet box, nginx proxies to it,
# and at cutover the domain's A records move at Porkbun. Nothing new is named.
APP_DOMAIN=${APP_DOMAIN:-nichedb.dev}
APP_DIR=${APP_DIR:-/home/anthony/www/$APP_DOMAIN}
APP_PORT=${APP_PORT:-3010}
APP_REPO=${APP_REPO:-https://github.com/profullstack/niche-db.git}
APP_BRANCH=${APP_BRANCH:-main}
CERT_DIR=/etc/nginx/ssl/$APP_DOMAIN

porkbun_keys() { # exports PORKBUN_API_KEY / PORKBUN_SECRET_API_KEY from cli-tools' store
  local f=$HOME/.config/cli-tools/credentials.json
  : "${PORKBUN_API_KEY:=$(jq -r '.porkbun.value // .porkbun // .PORKBUN_API_KEY // empty' "$f" 2>/dev/null)}"
  : "${PORKBUN_SECRET_API_KEY:=$(jq -r '.porkbun_secret.value // .porkbun_secret // .PORKBUN_SECRET_API_KEY // empty' "$f" 2>/dev/null)}"
  [ -n "$PORKBUN_API_KEY" ] && [ -n "$PORKBUN_SECRET_API_KEY" ] || die "no Porkbun keys: run 'cli-tools config pull' or export PORKBUN_API_KEY/PORKBUN_SECRET_API_KEY"
  export PORKBUN_API_KEY PORKBUN_SECRET_API_KEY
}

app_env_from_railway() { # the app's real environment is Railway's, rendered
  rw_vars "$RW_APP_SERVICE" | jq -r 'to_entries[] | select(.key | test("^RAILWAY_") | not) | "\(.key)=\(.value)"' |
    grep -Ev '^(DATABASE_URL|REDIS_URL|PORT|NODE_ENV)='
  printf 'DATABASE_URL=%s\n' "$(target_url | sed "s|@${DB_DOMAIN}:|@${APP_DB_HOST:-$DB_DOMAIN}:|")"
}

cmd_app_deploy() { # app-deploy [--start]   clone/pull + build; starts only with --start
  local start=0
  [ "${1:-}" = --start ] && start=1
  log "App: $APP_REPO@$APP_BRANCH -> $TARGET_SSH:$APP_DIR"
  tgt_exec "install -d -m 2755 -o anthony -g anthony $APP_DIR"
  tgt_exec "if [ -d $APP_DIR/app/.git ]; then cd $APP_DIR/app && git fetch -q origin && git checkout -q $APP_BRANCH && git reset -q --hard origin/$APP_BRANCH; else git clone -q -b $APP_BRANCH $APP_REPO $APP_DIR/app; fi; cd $APP_DIR/app && git log --oneline -1"
  local work
  work=$(mktemp -d)
  app_env_from_railway > "$work/app.env"
  note "$(wc -l < "$work/app.env") variables from Railway, DATABASE_URL -> this box"
  tgt_copy "$work/app.env" "$APP_DIR/app.env"
  tgt_copy "$HERE/app/docker-compose.app.yml" "$APP_DIR/docker-compose.app.yml"
  printf 'APP_PORT=%s\n' "$APP_PORT" > "$work/deploy.env"
  tgt_copy "$work/deploy.env" "$APP_DIR/deploy.env"
  rm -rf "$work"
  tgt_exec "chmod 600 $APP_DIR/app.env; cd $APP_DIR && docker compose -f docker-compose.app.yml --env-file deploy.env build -q app"
  note "image built"
  if [ "$start" = 1 ]; then
    tgt_exec "cd $APP_DIR && docker compose -f docker-compose.app.yml --env-file deploy.env up -d --wait"
    local ok=0
    for _ in $(seq 1 30); do
      [ "$(tgt_exec "curl -s -o /dev/null -w '%{http_code}' http://127.0.0.1:$APP_PORT/healthz")" = 200 ] && { ok=1; break; }
      sleep 4
    done
    [ "$ok" = 1 ] || { tgt_exec "cd $APP_DIR && docker compose -f docker-compose.app.yml logs --tail 40 app" >&2; die "app did not answer on 127.0.0.1:$APP_PORT/healthz"; }
    note "app healthy on 127.0.0.1:$APP_PORT"
  else
    note "not started (it would write to the target before the cutover); 'app-deploy --start' or 'cutover' starts it"
  fi
}

cmd_app_cert() { # DNS-01 through Porkbun, so the cert exists BEFORE the domain moves
  porkbun_keys
  log "Certificate for $APP_DOMAIN + www via acme.sh (Porkbun DNS-01)"
  tgt_exec "test -x /root/.acme.sh/acme.sh || curl -fsSL https://get.acme.sh | env HOME=/root sh -s email=anthony@profullstack.com >/dev/null"
  tgt_exec "install -d -m 0750 $CERT_DIR && env HOME=/root PORKBUN_API_KEY='$PORKBUN_API_KEY' PORKBUN_SECRET_API_KEY='$PORKBUN_SECRET_API_KEY' /root/.acme.sh/acme.sh --issue --server letsencrypt --dns dns_porkbun -d $APP_DOMAIN -d www.$APP_DOMAIN --force >/tmp/acme-$APP_DOMAIN.log 2>&1 || { tail -n 20 /tmp/acme-$APP_DOMAIN.log; exit 1; }"
  tgt_exec "env HOME=/root /root/.acme.sh/acme.sh --install-cert -d $APP_DOMAIN --fullchain-file $CERT_DIR/fullchain.pem --key-file $CERT_DIR/privkey.pem --reloadcmd 'systemctl reload nginx' >/dev/null"
  note "$(tgt_exec "openssl x509 -in $CERT_DIR/fullchain.pem -noout -subject -enddate | tr '\n' ' '")"
}

cmd_app_vhost() {
  log "nginx vhost for $APP_DOMAIN -> 127.0.0.1:$APP_PORT"
  tgt_exec "test -s $CERT_DIR/fullchain.pem" || die "no cert at $CERT_DIR: run 'nichedb-db app-cert' first"
  local work
  work=$(mktemp -d)
  sed -e "s/__DOMAIN__/$APP_DOMAIN/g" -e "s/__APP_PORT__/$APP_PORT/g" "$HERE/app/nginx-vhost.conf" > "$work/vhost"
  tgt_copy "$work/vhost" "/tmp/nichedb-vhost.conf"
  rm -rf "$work"
  tgt_exec "if [ -e /etc/nginx/sites-enabled/$APP_DOMAIN ]; then n=1; while [ -e /etc/nginx/sites-enabled/$APP_DOMAIN.bak-\$(printf %03d \$n) ]; do n=\$((n+1)); done; cp -a /etc/nginx/sites-enabled/$APP_DOMAIN /etc/nginx/sites-enabled/$APP_DOMAIN.bak-\$(printf %03d \$n); fi; install -m 0644 /tmp/nichedb-vhost.conf /etc/nginx/sites-available/$APP_DOMAIN && ln -sf /etc/nginx/sites-available/$APP_DOMAIN /etc/nginx/sites-enabled/$APP_DOMAIN && nginx -t 2>&1 | tail -n 1 && systemctl reload nginx"
  note "vhost live; test: curl -sk --resolve $APP_DOMAIN:443:$TARGET_IP https://$APP_DOMAIN/healthz"
}

cmd_app_dns() { # the flip: nichedb.dev + www -> this box, at Porkbun
  local ip=${1:-${TARGET_IP:-}}
  [ -n "$ip" ] || die "usage: nichedb-db app-dns <ipv4>"
  log "Porkbun: $APP_DOMAIN and www -> $ip"
  # The apex is an ALIAS to Railway today and www a CNAME; an A record cannot
  # coexist with either, so they go first. Backed up as JSON beside the state.
  porkbun ls "$APP_DOMAIN" --json > "$STATE_DIR/$APP_DOMAIN-dns.bak-$(date -u +%Y%m%dT%H%M%SZ).json"
  porkbun rm "$APP_DOMAIN" @ --type ALIAS --yes 2>/dev/null || true
  porkbun rm "$APP_DOMAIN" www --type CNAME --yes 2>/dev/null || true
  porkbun set "$APP_DOMAIN" @ A "$ip" --ttl 600
  porkbun set "$APP_DOMAIN" www A "$ip" --ttl 600
  save_state APP_DNS_FLIPPED "$(date -u +%FT%TZ)"
}

cmd_apply_migration() { # apply-migration packages/db/migrations/00xx_name.sql
  local f=${1:?usage: nichedb-db apply-migration <migration.sql>}
  log "Applying $(basename "$f") to the target (schema only; its schema_migrations row arrives through replication)"
  tgt_sql postgres < "$f"
  tgt_q "alter subscription $SUB enable" 2>/dev/null || true
  note "subscription re-enabled"
}

usage() {
  cat <<'EOF'
nichedb-db: move nichedb's Postgres from Railway to self-hosted Supabase.

In order:
  provision user@host   install Supabase on the new server (setup-server.sh)
  prepare-db user@host /path/to/supabase [db]
                        INSTEAD of provision when the box already runs a Supabase
                        cluster for another app: nichedb becomes a database in it
  vault                 push the server's secrets to the logicsrc team vaults
  check                 versions, sizes and free disk on both sides
  source-prep           Railway: wal_level=logical (RESTART), TCP proxy, publication
  schema                copy tables + primary keys to the target
  subscribe             start logical replication (initial copy, then streaming)
  status                copy progress, slot lag, errors
  indexes               build indexes/unique/foreign keys once the copy is done
  verify                schema diff + row counts (FULL=1 counts items too)
  app-deploy            clone + build the app under ~/www/nichedb.dev (not started)
  app-cert              cert for nichedb.dev + www over Porkbun DNS-01 (before DNS moves)
  app-vhost             nginx vhost -> 127.0.0.1:3010
  cutover               source read-only, drain, sequences; start the app on the
                        box, move DNS at Porkbun (Railway serves reads for the TTL)
  rollback              point the app back at Railway and make it writable
  cleanup               drop publication/slot and the TCP proxy (after you're sure)

Other:
  dns [ipv4]            only with DB_DOMAIN=<name under nichedb.dev>: add its A record
  fetch-connection      re-read nichedb-connection.env from the server
  apply-migration FILE  a migration shipped mid-copy: apply its SQL to the target
                        and re-enable the subscription

Flags: --yes skips confirmations. State lives in ~/.local/state/nichedb-selfhost.
EOF
}

main() {
  local args=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --yes | -y) YES=1 ;;
      *) args+=("$1") ;;
    esac
    shift
  done
  set -- "${args[@]:-help}"
  local cmd=$1
  shift || true
  case "$cmd" in
    provision) cmd_provision "$@" ;;
    prepare-db) cmd_prepare_db "$@" ;;
    app-deploy) cmd_app_deploy "$@" ;;
    app-cert) cmd_app_cert ;;
    app-vhost) cmd_app_vhost ;;
    app-dns) cmd_app_dns "$@" ;;
    fetch-connection) cmd_fetch_connection ;;
    vault) cmd_vault ;;
    dns) cmd_dns "$@" ;;
    check) cmd_check ;;
    source-prep) cmd_source_prep ;;
    schema) cmd_schema ;;
    subscribe) cmd_subscribe ;;
    status) cmd_status ;;
    indexes) cmd_indexes ;;
    verify) cmd_verify ;;
    cutover) cmd_cutover ;;
    rollback) cmd_rollback ;;
    cleanup) cmd_cleanup ;;
    apply-migration) cmd_apply_migration "$@" ;;
    help | -h | --help) usage ;;
    *) usage; exit 1 ;;
  esac
}

# NICHEDB_DB_LIB=1 lets test/make-fixture.sh source the helpers without main.
[ "${NICHEDB_DB_LIB:-0}" = 1 ] || main "$@"
